{
  "name": "whatsapp-quickstart",
  "version": "0.1.1",
  "description": "An independent Ubuntu desktop wrapper for WhatsApp Web",
  "main": "src/main.js",
  "author": "OptiServe Solutions",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --linux --dir",
    "dist": "electron-builder --linux deb AppImage --x64 --publish never",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "solutions.optiserve.whatsappquickstart",
    "productName": "WhatsApp QuickStart",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "maintainer": "OptiServe Solutions",
      "desktop": {
        "entry": {
          "StartupWMClass": "whatsapp-quickstart",
          "Comment": "Open WhatsApp Web in a dedicated desktop window"
        }
      },
      "syncDesktopName": true
    },
    "artifactName": "WhatsApp-QuickStart-${version}-${arch}.${ext}"
  },
  "desktopName": "whatsapp-quickstart.desktop",
  "homepage": "https://www.optiserve.solutions"
}
